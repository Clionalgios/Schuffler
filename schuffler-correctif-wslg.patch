+    def _verdicts(self, attendus, mesure):
+        """Verdicts des quatre sorties pour une mesure unique."""
+        verdicts = {}
+        for cle in ("stdout", "stderr", "clipboard", "code_retour"):
+            verdicts[cle] = self.evaluer(
+                cle, attendus.get(cle), mesure.get(cle),
+                pp_disponible=self.pp_disponible())
+        return verdicts
+
+    def _course_presse_papiers(self, verdicts):
+        """Vrai si l'échec observé porte la signature d'une course de
+        synchronisation du presse-papiers POSIX.
+
+        Sous WSLg notamment, la sélection X11 posée par le programme
+        peut être perdue — démon xclip interrompu, la récolte des tubes
+        s'achève alors avant le délai de grâce — ou écrasée un instant
+        par une valeur résiduelle du presse-papiers de Windows
+        réassertée dans la sélection ; la lecture retombe alors sur une
+        valeur ancienne, sans que le programme ait rien manqué : sorties
+        et code de retour restent exacts. Une telle course ne survit
+        pas à une réexécution, quand une défaillance réelle du
+        programme, elle, se reproduit à l'identique à chacune d'elles.
+        """
+        return (self.outil_pp is not None
+                and verdicts.get("clipboard") == "ECHEC"
+                and all(statut in ("OK", "A_DEFINIR")
+                        for cle, statut in verdicts.items()
+                        if cle != "clipboard"))
